{
  "filesystem": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "<HOME>"
    ]
  },
  "github": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-github"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_PAT>"
    }
  },
  "codegraph": {
    "command": "codegraph",
    "args": [
      "serve",
      "--mcp"
    ],
    "note": "npm i -g codegraph"
  },
  "exa": {
    "command": "node",
    "args": [
      "<LOCAL_EXA_MCP_PATH>"
    ],
    "env": {
      "EXA_API_KEY": "<YOUR_EXA_API_KEY>",
      "ENABLED_TOOLS": "web_search_exa,web_fetch_exa,agent_tools"
    }
  }
}